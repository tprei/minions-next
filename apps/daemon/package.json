{
  "name": "@minions/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "minions-daemon": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@bufbuild/protovalidate": "1.2.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@connectrpc/validate": "0.2.0",
    "@minions/adapters": "workspace:*",
    "@minions/contracts": "workspace:*",
    "@minions/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
