{
  "name": "minions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && pnpm -r exec tsc --noEmit --pretty false -p tsconfig.json",
    "verify:pr": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deadcode && pnpm test:unit && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "knip": "6.26.0",
    "prettier": "3.9.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
